# Template file for 'aquamarine'
pkgname=aquamarine
version=0.16.0
revision=1
build_style=cmake
hostmakedepends="pkg-config hyprwayland-scanner"
makedepends="eudev-libudev-devel hwids hyprutils-devel libdisplay-info-devel
 libdrm-devel libgbm-devel libglvnd-devel libinput-devel libseat-devel
 pixman-devel wayland-devel wayland-protocols"
short_desc="Very light Linux rendering backend library"
maintainer="zanxey <z@zanxey.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/aquamarine"
changelog="https://github.com/hyprwm/aquamarine/releases"
distfiles="https://github.com/hyprwm/aquamarine/archive/refs/tags/v${version}.tar.gz"
checksum=42339c3096c9de6582c0d71bc86b7e63334a3faf6a2b917d385ad093caf66c3c

post_install() {
	vlicense LICENSE
}

aquamarine-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} hyprutils-devel libdrm-devel
	 wayland-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
