# Template file for 'desktop-plus'
pkgname=desktop-plus
version=3.6.11.0
revision=1
archs="x86_64 aarch64"
create_wrksrc=yes
# libnotify is dlopen()ed by Electron for notifications.
depends="libnotify xdg-utils"
short_desc="GitHub Desktop fork with advanced functionality for power users"
maintainer="zanxey <z@zanxey.com>"
license="MIT"
homepage="https://desktop-plus.org"
changelog="https://github.com/desktop-plus/desktop-plus/releases"
case "$XBPS_TARGET_MACHINE" in
	x86_64)
		_debarch=x86_64
		checksum=c87e84ddf2b4219ea550150ee526cd07380a42b78b55a781446c8203e14b0a50
		;;
	aarch64)
		_debarch=arm64
		checksum=db10da6dfe97761dd0e3eb38182dc3ff704bf4e98fd8392558ce59a56f6aa8ca
		;;
esac
distfiles="https://github.com/desktop-plus/desktop-plus/releases/download/v${version}/DesktopPlus-v${version}-linux-${_debarch}.deb"
nostrip=yes
noshlibprovides=yes

do_install() {
	vmkdir usr/lib
	vcopy usr/lib/desktop-plus usr/lib
	vmkdir usr/share
	vcopy usr/share/icons usr/share
	vinstall usr/share/applications/desktop-plus.desktop 644 usr/share/applications

	chmod 755 ${DESTDIR}/usr/lib/desktop-plus/resources/app/static/desktop-plus-cli
	vbin ${FILESDIR}/desktop-plus
	ln -s ../lib/desktop-plus/resources/app/static/desktop-plus-cli \
		${DESTDIR}/usr/bin/desktop-plus-cli

	vlicense usr/share/doc/desktop-plus/copyright LICENSE
}
