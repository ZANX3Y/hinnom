# Template file for 'hyprcursor'
pkgname=hyprcursor
version=0.1.14
revision=1
build_style=cmake
hostmakedepends="pkg-config"
makedepends="cairo-devel hyprlang-devel librsvg-devel libzip-devel
 tomlplusplus-devel"
short_desc="Hyprland cursor format, library and utilities"
maintainer="zanxey <z@zanxey.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprcursor"
changelog="https://github.com/hyprwm/hyprcursor/releases"
distfiles="https://github.com/hyprwm/hyprcursor/archive/refs/tags/v${version}.tar.gz"
checksum=f835995a1225ab169723d5e4e7510e31231dbb3048c4da6de6f6a51794e4cb38

post_install() {
	vlicense LICENSE
}

hyprcursor-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} cairo-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
