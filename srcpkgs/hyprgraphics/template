# Template file for 'hyprgraphics'
pkgname=hyprgraphics
version=0.6.0
revision=1
build_style=cmake
hostmakedepends="pkg-config"
makedepends="cairo-devel file-devel hyprutils-devel libdrm-devel libglvnd-devel
 libheif-devel libjpeg-turbo-devel libjxl-devel libpng-devel librsvg-devel
 libwebp-devel pango-devel pixman-devel"
short_desc="Hyprland graphics resources and utilities"
maintainer="zanxey <z@zanxey.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprgraphics"
changelog="https://github.com/hyprwm/hyprgraphics/releases"
distfiles="https://github.com/hyprwm/hyprgraphics/archive/refs/tags/v${version}.tar.gz"
checksum=27e9e19ff59ba75a2963d72c3dcb5c0840b266b90d7fca6d5df7cac105419b08

post_install() {
	vlicense LICENSE
}

hyprgraphics-devel_package() {
	# everything in hyprgraphics.pc Requires and Requires.private
	depends="${sourcepkg}>=${version}_${revision} cairo-devel file-devel
	 hyprutils-devel libdrm-devel libglvnd-devel libheif-devel libjpeg-turbo-devel
	 libjxl-devel libpng-devel librsvg-devel libwebp-devel pango-devel pixman-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
