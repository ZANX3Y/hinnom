# Template file for 'hyprwire'
pkgname=hyprwire
version=0.3.1
revision=3
build_style=cmake
hostmakedepends="pkg-config"
makedepends="hyprutils-devel libffi-devel pugixml-devel"
short_desc="Fast and consistent wire protocol for IPC"
maintainer="zanxey <z@zanxey.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprwire"
changelog="https://github.com/hyprwm/hyprwire/releases"
distfiles="https://github.com/hyprwm/hyprwire/archive/refs/tags/v${version}.tar.gz"
checksum=92a673d40ae6a7d66fbcd0a34ec071e026e17eaeeb0040c3375e4b2a80dba737

post_install() {
	vlicense LICENSE
}

hyprwire-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} hyprutils-devel libffi-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
