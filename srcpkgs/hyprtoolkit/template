# Template file for 'hyprtoolkit'
pkgname=hyprtoolkit
version=0.6.0
revision=2
build_style=cmake
hostmakedepends="pkg-config hyprwayland-scanner"
makedepends="abseil-cpp-devel aquamarine-devel cairo-devel hyprgraphics-devel
 hyprlang-devel hyprutils-devel iniparser-devel libdrm-devel libgbm-devel
 libglvnd-devel libxkbcommon-devel pango-devel pixman-devel wayland-devel
 wayland-protocols"
short_desc="Modern C++ Wayland-native GUI toolkit"
maintainer="zanxey <z@zanxey.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprtoolkit"
changelog="https://github.com/hyprwm/hyprtoolkit/releases"
distfiles="https://github.com/hyprwm/hyprtoolkit/archive/refs/tags/v${version}.tar.gz"
checksum=53c41be72af97d9ede274a63c9c1034c58726d862905763ed6e5a564ae42ba6b

post_install() {
	vlicense LICENSE
}

hyprtoolkit-devel_package() {
	# everything in hyprtoolkit.pc Requires and Requires.private
	depends="${sourcepkg}>=${version}_${revision} abseil-cpp-devel
	 aquamarine-devel cairo-devel hyprgraphics-devel hyprlang-devel hyprutils-devel
	 iniparser-devel libdrm-devel libgbm-devel libglvnd-devel libxkbcommon-devel
	 pango-devel pixman-devel wayland-devel wayland-protocols"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
