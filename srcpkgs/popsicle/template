# Template file for 'popsicle'
pkgname=popsicle
version=1.3.3.20261110
revision=1
_commit=3b80eee93977a5892b4d6ef76c3fedf09495b830
build_style=cargo
make_build_args="--workspace"
hostmakedepends="help2man pkg-config"
makedepends="libxkbcommon-devel wayland-devel"
# Window-system and graphics libraries are loaded dynamically by the COSMIC UI.
depends="libglvnd libX11 libXcursor libXi libXrandr libxkbcommon
 libxkbcommon-x11 udisks2 wayland xdg-desktop-portal xdg-utils"
short_desc="Multiple USB image flasher"
maintainer="zanxey <z@zanxey.com>"
license="MIT, GPL-2.0-only"
homepage="https://github.com/pop-os/popsicle"
distfiles="https://github.com/pop-os/popsicle/archive/${_commit}.tar.gz"
checksum=fbf162856bbc0e5e22b2b6d97b897bdd712480c6fd1c8db563475f0c47b99788

post_patch() {
	rm rust-toolchain
}

do_install() {
	local rel=target/${RUST_TARGET}/release icon

	vbin ${rel}/popsicle
	vbin ${rel}/popsicle-ui
	help2man --no-info ${rel}/popsicle > popsicle.1
	vman popsicle.1

	vinstall ui/target/xdgen/app.desktop 644 \
		usr/share/applications com.system76.Popsicle.desktop
	vinstall ui/target/xdgen/app.metainfo.xml 644 \
		usr/share/metainfo com.system76.Popsicle.appdata.xml
	for icon in $(cd resources/icons/hicolor && find . -name '*.png'); do
		vinstall resources/icons/hicolor/${icon} 644 usr/share/icons/hicolor/${icon%/*}
	done
	vinstall resources/icons/hicolor/scalable/apps/icon.svg 644 \
		usr/share/icons/hicolor/scalable/apps com.system76.Popsicle.svg
	vlicense LICENSE
}
