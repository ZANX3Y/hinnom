# Template file for 'popsicle'
pkgname=popsicle
version=1.3.3.20260901
revision=1
_commit=924f78ce132fe994a62e31c91a1a4bc1bcb0cf2f
build_style=cargo
make_build_args="--workspace"
hostmakedepends="glib-devel help2man pkg-config"
makedepends="dbus-devel gtk+3-devel"
depends="udisks2"
short_desc="Multiple USB image flasher"
maintainer="zanxey <z@zanxey.com>"
license="MIT"
homepage="https://github.com/pop-os/popsicle"
distfiles="https://github.com/pop-os/popsicle/archive/${_commit}.tar.gz"
checksum=d983ffa42d037dc7b5f178435bb00b7e38cd322fc85b4876c5f3563bd066f47d

post_patch() {
	# time < 0.3.35 fails to build with Rust >= 1.80.
	cargo update --package time:0.3.31 --precise 0.3.36
	rm rust-toolchain
}

do_install() {
	local rel=target/${RUST_TARGET}/release icon

	vbin ${rel}/popsicle
	vbin ${rel}/popsicle-gtk
	help2man --no-info ${rel}/popsicle > popsicle.1
	vman popsicle.1

	vinstall gtk/assets/com.system76.Popsicle.desktop 644 usr/share/applications
	vinstall gtk/assets/com.system76.Popsicle.appdata.xml 644 usr/share/metainfo
	for icon in $(cd gtk/assets/icons && find . -name '*.png'); do
		vinstall gtk/assets/icons/${icon} 644 usr/share/icons/hicolor/${icon%/*}
	done
	vlicense LICENSE
}
