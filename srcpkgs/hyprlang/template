# Template file for 'hyprlang'
pkgname=hyprlang
version=0.6.8
revision=3
build_style=cmake
hostmakedepends="pkg-config"
makedepends="hyprutils-devel"
short_desc="Official implementation library for the hypr config language"
maintainer="zanxey <z@zanxey.com>"
license="LGPL-3.0-only"
homepage="https://hyprland.org/hyprlang/"
changelog="https://github.com/hyprwm/hyprlang/releases"
distfiles="https://github.com/hyprwm/hyprlang/archive/refs/tags/v${version}.tar.gz"
checksum=d10a0778b646e04d83e8b90cc0f764fb96958c01a15c3c0678d95a40fc647ed5

hyprlang-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} hyprutils-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
