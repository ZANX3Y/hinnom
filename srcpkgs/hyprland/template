# Template file for 'hyprland'
pkgname=hyprland
version=0.57.2
revision=1
build_style=cmake
configure_args="-DNO_SYSTEMD=ON"
hostmakedepends="glslang hyprwayland-scanner hyprwire pkg-config xxd"
# SPIRV-Tools-devel: glslang's CMake config requires SPIRV-Tools-opt
makedepends="aquamarine-devel cairo-devel glaze glslang-devel hyprcursor-devel
 hyprgraphics-devel hyprland-protocols hyprlang-devel hyprutils-devel
 hyprwire-devel lcms2-devel libcanberra-devel libdrm-devel libei-devel
 libgbm-devel libglvnd-devel libinput-devel libuuid-devel libxcb-devel
 libXcursor-devel libxkbcommon-devel lua55-devel muparser-devel pango-devel
 pixman-devel re2-devel readline-devel SPIRV-Tools-devel
 tomlplusplus-devel udis86-devel wayland-devel wayland-protocols
 xcb-util-errors-devel xcb-util-wm-devel xorg-server-xwayland"
depends="hyprland-guiutils xorg-server-xwayland"
short_desc="Dynamic tiling Wayland compositor that doesn't sacrifice on its looks"
maintainer="zanxey <z@zanxey.com>"
license="BSD-3-Clause"
homepage="https://hypr.land/"
changelog="https://github.com/hyprwm/Hyprland/releases"
distfiles="https://github.com/hyprwm/Hyprland/releases/download/v${version}/source-v${version}.tar.gz"
checksum=34dbec0738ab88c8228caf89385662688ab1601ea58fbe5c60a6b6ab383db46d

pre_configure() {
	# GCC 14 has no #embed; generate the array the patched header includes
	xxd -i -n EXAMPLE_CONFIG_BYTES_LUA example/hyprland.lua \
		> src/config/lua/example_config_lua_data.h
}

post_install() {
	vlicense LICENSE
}

hyprland-devel_package() {
	# everything hyprland.pc requires, plus glslang (headers, no .pc)
	depends="${sourcepkg}>=${version}_${revision} aquamarine-devel cairo-devel
	 glslang-devel hyprcursor-devel hyprgraphics-devel hyprlang-devel
	 hyprutils-devel libdrm-devel libei-devel libglvnd-devel libinput-devel
	 libxcb-devel libxkbcommon-devel lua55-devel wayland-devel
	 xcb-util-errors-devel xcb-util-wm-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/share/pkgconfig
	}
}
